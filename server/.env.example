# Copy this file to ".env" and fill in the values from your Salesforce
# External Client App (Setup -> External Client App Manager)

# --- Salesforce OAuth ---
SF_CLIENT_ID=your_consumer_key_here
SF_CLIENT_SECRET=your_consumer_secret_here
SF_LOGIN_URL=https://login.salesforce.com
SF_REDIRECT_URI=http://localhost:5000/auth/callback
SF_API_VERSION=v61.0

# --- App ---
PORT=5000
SESSION_SECRET=change_this_to_a_long_random_string
# Where the React app runs (used for CORS + post-login redirect)
CLIENT_URL=http://localhost:5173
